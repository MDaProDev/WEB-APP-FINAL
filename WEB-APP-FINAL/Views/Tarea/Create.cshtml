@model WEB_APP_FINAL.Models.Tarea

@{
    ViewData["Title"] = "Create";
}

<body>
    <form asp-action="Create">
        <div class="Form-row">
            <h2>Add Task</h2>
            <div class="footer align-items-center">
                <button type="submit" class="btn-primary" style="background-color:#ffc107; border-radius: 5px">Confirm</button>
            </div>
            <div class="form-group">
                <input type="text" asp-for="Description" placeholder="Description" required class="form-control"
                       style="background-color: dimgrey; outline:none; margin-bottom: 10px; text-align: center" />
            </div>
            <div class="form-group">
                <input type="datetime-local" asp-for="Date" class="form-control" placeholder="Date" required
                       style="background-color: dimgrey; outline:none; margin-bottom: 10px; text-align: center" />
            </div>
            <div style="glyph-orientation-horizontal:inherit; width:max-content" class=" collapse d-sm-inline-flex justify-content-between">
                <div class="form-group">
                    <select asp-for="ProductoId" asp-items="@(ViewData["Producto"] as SelectList)" class="form-control" placeholder="Producto"
                           style="background-color: dimgrey; outline:none; margin-bottom: 10px; margin-inline-end:10px; text-align: center; width: 228px"></select>
                </div>
                <div style="glyph-orientation-horizontal:inherit; width:max-content" class=" collapse d-sm-inline-flex justify-content-between">
                    
                    <input type="checkbox" asp-for="Done" style="background-color: dimgrey; outline:none; vertical-align:central" class="form-check-input"/>
                    
                </div>

            </div>
        </div>
    </form>
</body>