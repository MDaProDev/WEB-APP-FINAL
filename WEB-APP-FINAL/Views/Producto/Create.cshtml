@model WEB_APP_FINAL.Models.Producto

<body>
    <form asp-action="Create">
        <div class="Form-row">
            <h2>Add items</h2>
            <div class="footer align-items-center">
                <button type="submit" class="btn-primary" style="background-color:#ffc107; border-radius: 5px">Confirm</button>
            </div>
            <div class="form-group">
                <input type="text" asp-for="Name" placeholder="Name" required class="form-control"
                       style="background-color: dimgrey; outline:none; margin-bottom: 10px; text-align: center" />
            </div>
            <div class="form-group">
                <input type="number" asp-for="Price" class="form-control" placeholder="Price" required min="0"
                       style="background-color: dimgrey; outline:none; margin-bottom: 10px; height:100px; text-align: center" />
            </div>
            <div style="glyph-orientation-horizontal:inherit; width:max-content" class=" collapse d-sm-inline-flex justify-content-between">
                <div class="form-group">
                    <input type="number" asp-for="Stock" class="form-control" placeholder="Stock" required min="0"
                           style="background-color: dimgrey; outline:none; margin-bottom: 10px; margin-inline-end:10px; text-align: center; width: 228px" />
                </div>
                
            </div>
        </div>
    </form>
</body>