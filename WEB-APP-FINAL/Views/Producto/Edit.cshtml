@model WEB_APP_FINAL.Models.Producto

@{
    ViewData["Title"] = @Model.Name;
}


<body>
    <h2> @ViewData["Title"] </h2>
    <div style="glyph-orientation-horizontal:inherit; width:max-content" class=" collapse d-sm-inline-flex justify-content-between">

        <form asp-action="Edit" method="post">
            <div class="Form-row">
                <h5 style="margin-inline-start:50px">Edit item</h5>

                <div class="model-footer align-content-center" style="margin-inline-start:50px">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>

                <div style="width:800px; margin-inline-start:50px">
                    <input type="hidden" asp-for="Id" />
                    <div class="form-group">
                        <label>Name</label>
                        <input asp-for="Name" type="text" class="form-control" style="background-color:dimgrey" required />
                    </div>
                    <div class="form-group">
                        <label>Price</label>
                        <input type="number" asp-for="Price" class="form-control" style="background-color:dimgrey" required />
                    </div>
                    <div class="form-group">
                        <label>Stock</label>
                        <input type="number" asp-for="Stock" class="form-control" style="background-color:dimgrey" />
                    </div>
                </div>

            </div>
        </form>
    </div>
</body>
